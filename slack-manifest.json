{
  "display_information": {
    "name": "Partner Agent",
    "description": "Capture Runpod partnership requests in Notion"
  },
  "features": {
    "bot_user": {
      "display_name": "Partner Agent",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "channels:history",
        "groups:history",
        "chat:write",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE-WITH-APP-HOST/slack/events",
      "bot_events": [
        "message.channels",
        "message.groups",
        "app_mention"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
