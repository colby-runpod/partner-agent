# Global runtime. Keep false until the standalone service is protected by HTTPS.
P_OPS_ENABLED=false
P_OPS_DB=/data/p_ops.sqlite3
P_OPS_POLL_SECONDS=5

# Slack handshake capture. IDs are comma-separated allowlists.
P_OPS_CAPTURE_ENABLED=false
P_OPS_CAPTURE_CHANNEL_IDS=
P_OPS_CAPTURE_USER_IDS=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_BOT_TOKEN=

# Protected review dashboard at /review. Use host-generated random secrets.
P_OPS_REVIEW_USER=
P_OPS_REVIEW_PASSWORD=
P_OPS_CSRF_SECRET=

# Notion reads and queues a daily review. Every write class stays separate.
NOTION_TOKEN=
P_OPS_DAILY_REVIEW_ENABLED=false
P_OPS_NOTION_CREATE=false
P_OPS_NOTION_WRITE=false

# Linear pilot. OAuth is preferred for a hosted service identity.
LINEAR_ACCESS_TOKEN=
LINEAR_AUTH_MODE=oauth
P_OPS_LINEAR_WRITE=false

# Outbound communication. Approval and authorization are still required.
P_OPS_SEND_MESSAGES=false
