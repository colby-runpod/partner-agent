# Global runtime. Keep false until the standalone service is protected by HTTPS.
P_OPS_ENABLED=false
P_OPS_DB=/data/p_ops.sqlite3
P_OPS_POLL_SECONDS=5

# Slack handshake capture. IDs are comma-separated allowlists.
P_OPS_CAPTURE_ENABLED=false
P_OPS_CAPTURE_CHANNEL_IDS=
P_OPS_CAPTURE_USER_IDS=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_BOT_TOKEN=

# Protected review dashboard at /review. Use host-generated random secrets.
P_OPS_REVIEW_USER=
P_OPS_REVIEW_PASSWORD=
P_OPS_CSRF_SECRET=

# Notion reads and queues a daily review. Every write class stays separate.
NOTION_TOKEN=
P_OPS_DAILY_REVIEW_ENABLED=false
P_OPS_NOTION_CREATE=false
P_OPS_NOTION_WRITE=false

# Read-only model analysis of captured proposals. It writes only to the local audit database.
# It uses the existing Claude API project and never authorizes an external action.
P_OPS_TRIAGE_SHADOW_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Internal review notifications are restricted to one approved Slack channel.
# This does not enable general messages, Notion writes, or task execution.
P_OPS_REVIEW_POSTING_ENABLED=false
P_OPS_REVIEW_CHANNEL_ID=
P_OPS_REVIEW_INTERACTIVE_ENABLED=false
P_OPS_REVIEW_USER_IDS=
P_OPS_PUBLIC_URL=https://<partner-ops-aws-service-domain>

# Guarded Working Task progression. A task must explicitly request a
# communication draft and pass every deterministic confidence/risk check.
# Routes are an exact destination allowlist. Prepared messages are reviewed in
# ask-partners and are never sent while P_OPS_SEND_MESSAGES=false.
P_OPS_TASK_PROGRESSION_ENABLED=false
P_OPS_TASK_PROGRESSION_MIN_CONFIDENCE=0.80
P_OPS_TASK_PROGRESSION_MAX_RISK=35
P_OPS_TASK_PROGRESSION_MIN_PRIORITY=40
P_OPS_TASK_PROGRESSION_ROUTES=[]

# Guarded weekday Working Task briefing. This is owned only by the partner-ops
# Slack app (A0CA2C43D4L), never int-partner-agent.
P_OPS_WORKING_TASK_BRIEF_ENABLED=false
P_OPS_WORKING_TASK_BRIEF_CHANNEL_ID=C0C7HG8KYFL
P_OPS_WORKING_TASK_BRIEF_HOUR=8
P_OPS_WORKING_TASK_BRIEF_MINUTE=15
P_OPS_WORKING_TASK_BRIEF_MAX_AGE_HOURS=3
P_OPS_WORKING_TASK_BRIEF_RUN_LOG_ID=8d12b4ca-c723-4372-827c-d607070179a2
P_OPS_WORKING_TASK_BRIEF_TASKS_DATA_SOURCE_ID=e77648f6-502d-450f-8b79-4dd2ced52bab
P_OPS_WORKING_TASK_FEEDBACK_USER_IDS=

# Linear pilot. OAuth is preferred for a hosted service identity.
LINEAR_ACCESS_TOKEN=
LINEAR_AUTH_MODE=oauth
P_OPS_LINEAR_WRITE=false

# Outbound communication. Approval and authorization are still required.
P_OPS_SEND_MESSAGES=false
