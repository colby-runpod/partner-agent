# Separate Railway development environment; do not reuse the Slack service start command.
DATABASE_URL=
APP_ORIGIN=https://YOUR-PARTNEROS-WEB-DOMAIN
PORT=3000
NODE_ENV=production
SESSION_SECRET=
# salt:hex scrypt hash, generated with the command in README.md
REVIEWER_PASSWORD_HASH=
# Keep demo disabled in production. Synthetic demo is optional in development.
DEMO_MODE=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
TAVILY_API_KEY=
APPROVED_RESEARCH_DOMAINS=
# Enter current contracted prices. No guessed prices are built into the app.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
SEARCH_USD_PER_REQUEST=
MAX_RUN_USD=
