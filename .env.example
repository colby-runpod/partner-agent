# Set these in your environment or deployment secret store. Never commit secrets.
NOTION_TOKEN=
NOTION_VERSION=2025-09-03
OPENAI_API_KEY=
OPENAI_MODEL=

# Immediate intake service. Supply values in hosting secrets, not Git.
INTAKE_ENABLED=false
INTAKE_DB=/data/intake.sqlite3
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
SLACK_APP_ID=
# Both identify the existing, trusted form-notification integration.
FORM_APP_ID=
FORM_BOT_ID=

# Slack-only chat; no Notion credentials required.
CHAT_ENABLED=false
CHAT_DB=/data/chat.sqlite3
CHAT_CHANNEL_IDS=C0BQKEQLSKH
CHAT_USER_IDS=U0BEHPEJA6L
# Slack chat uses Claude; the older CLI AI mode uses the OpenAI settings above.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
